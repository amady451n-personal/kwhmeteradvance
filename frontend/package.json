{
  "name": "meteran-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "api:types": "openapi-typescript /docs/api/openapi.yaml -o src/api/schema.d.ts && chown ${HOST_UID:-1000}:${HOST_GID:-1000} src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@mdi/font": "7.4.47",
    "pinia": "4.1.0",
    "vue": "3.5.46",
    "vue-router": "5.5.1",
    "vuetify": "4.3.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "openapi-typescript": "7.13.0",
    "sass": "1.108.2",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-vuetify": "2.1.3",
    "vue-tsc": "3.3.14"
  }
}
