# Copy to .env on the machine that runs compose:
#   cp .env.example .env
# Untracked on purpose: per-machine values (port, data folder, uid) never dirty
# the working tree and never block `git pull`. release.sh creates it if missing.
METERAN_PORT=8080
# Relative to the folder that holds compose.yml. Absolute paths also work.
METERAN_DATA_DIR=./data
# uid/gid that own the data folder on the host (armbian user is usually 1000).
METERAN_UID=1000
METERAN_GID=1000
# METERAN_COOKIE_SECURE=1 set this when the app is only reachable over HTTPS.
# Request per menit per IP untuk /api/*; naikkan bila banyak klien di belakang satu proxy.
METERAN_RATE_LIMIT=3000
# Notifikasi push. Biarkan kosong: server membuat sendiri pasangan kunci VAPID
# sekali dan menyimpannya di folder data (vapid.json), jadi langsung jalan tanpa
# langkah tambahan. Isi hanya kalau mau memakai kunci sendiri:
#   npx web-push generate-vapid-keys
METERAN_VAPID_PUBLIC=
METERAN_VAPID_PRIVATE=