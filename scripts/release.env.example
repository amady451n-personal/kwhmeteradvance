# Copy to ~/.config/meteran/release.env (preferred, outside the repo) and fill in.
#   mkdir -p ~/.config/meteran && cp scripts/release.env.example ~/.config/meteran/release.env
# An in-repo scripts/release.env still works and is picked up once, then copied
# to the location above. Override either with RELEASE_ENV=/path/file.
# Untracked on purpose: no script rewrites or deletes it.

# auto  = local when STB_DIR exists on this machine, otherwise ssh to STB_HOST
# local = run every command here (script copied to / run on the host itself)
# remote = run them over ssh (script run on the laptop)
STB_MODE=auto

# Deploy folder: the checkout that holds compose.yml
STB_DIR=/home/armbian/dipsik

# Only needed when STB_MODE resolves to remote
STB_HOST=192.168.1.10
STB_USER=armbian

IMAGE=meteranadvanced:latest
# Optional: folder on the deploy machine, default $STB_DIR/backups
# BACKUP_DIR=/home/armbian/backups/meteranadvanced
# BACKUP_KEEP=14